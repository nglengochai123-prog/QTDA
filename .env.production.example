# MẪU cấu hình máy chủ thật. Sao chép thành .env trên máy chủ rồi điền giá trị.
# Tệp .env thật không bao giờ đưa lên kho mã (.gitignore đã chặn). Tệp này chỉ chứa tên khóa, không chứa bí mật.
# Cấu hình chạy thử trên máy cá nhân xem .env.example.

DJANGO_DEBUG=false
# Tạo bằng: .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Tên miền thật của quán, cách nhau bằng dấu phẩy
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=https://
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_STATIC_MANIFEST=true

DB_ENGINE=postgresql
DB_NAME=lamcoffee
DB_USER=lamcoffee
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Sao lưu (NFR-09): thư mục nằm ngoài máy chủ hoặc được đồng bộ ra ngoài; giữ tối thiểu 30 bản
LAM_BACKUP_DIR=
LAM_BACKUP_KEEP=30
# Thư mục chứa pg_dump, pg_restore nếu không có trong PATH
LAM_PG_BIN=

# Thông báo đẩy: tạo khóa VAPID riêng cho máy chủ thật, không dùng lại khóa thử
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_CONTACT=mailto:

LAM_STORE_CODE=LAM01
LAM_STORE_NAME=LAM Coffee
SESSION_IDLE_SECONDS=900
LOG_LEVEL=INFO
