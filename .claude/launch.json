{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lam-django",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "127.0.0.1:8765",
        "--noreload"
      ],
      "port": 8765
    },
    {
      "name": "lam-nghiem-thu",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "127.0.0.1:8766",
        "--noreload"
      ],
      "env": {
        "SQLITE_NAME": "nghiem_thu.sqlite3"
      },
      "port": 8766
    },
    {
      "name": "lam-thu-thong-bao",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "127.0.0.1:8767",
        "--noreload",
        "--insecure"
      ],
      "env": {
        "LAM_ENV_FILE": ".secrets/thu_thong_bao.env"
      },
      "port": 8767
    },
    {
      "name": "lam-thu-du-bao",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "127.0.0.1:8768",
        "--noreload"
      ],
      "env": {
        "SQLITE_NAME": "thu_du_bao.sqlite3",
        "LAM_FORECAST_INCLUDE_SIMULATED": "true"
      },
      "port": 8768
    },
    {
      "name": "lam-thuc-don",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "127.0.0.1:8769",
        "--noreload"
      ],
      "env": {
        "SQLITE_NAME": "thuc_don_lam.sqlite3"
      },
      "port": 8769
    }
  ]
}