# Sao chép thành .env rồi sửa giá trị. Không đưa .env lên kho mã.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# sqlite (chạy thử) hoặc postgresql (triển khai thật)
DB_ENGINE=sqlite
DB_NAME=lamcoffee
DB_USER=lamcoffee
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

LAM_STORE_CODE=LAM01
LAM_STORE_NAME=LAM Coffee
SESSION_IDLE_SECONDS=900
