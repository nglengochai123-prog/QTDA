# MẪU cấu hình chạy thử trên máy cá nhân. Sao chép thành .env rồi sửa giá trị. Không đưa .env lên kho mã.
# Máy chủ thật dùng mẫu .env.production.example.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# sqlite (chạy thử) hoặc postgresql (triển khai thật)
DB_ENGINE=sqlite
DB_NAME=lamcoffee
DB_USER=lamcoffee
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

LAM_STORE_CODE=LAM01
LAM_STORE_NAME=LAM Coffee
SESSION_IDLE_SECONDS=900

# Sao lưu: mặc định thư mục backups trong dự án, giữ 30 bản
LAM_BACKUP_DIR=
LAM_BACKUP_KEEP=30
